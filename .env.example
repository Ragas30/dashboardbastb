# Supabase PostgreSQL environment variables.
# Copy this file to `.env` and replace both placeholders from Supabase:
# Project Settings > Database > Connection string.
#
# DATABASE_URL: pooled connection string (runtime/application).
# DIRECT_URL: direct connection string (Prisma CLI/tools).
# Keep the values URL-encoded when the password contains special characters.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
